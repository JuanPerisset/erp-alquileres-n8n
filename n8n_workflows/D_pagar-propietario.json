      "name": "Edit Fields"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH datos_pago AS (\n    SELECT \n        lm.id_liquidacion,\n        ca.id_contrato,\n        COALESCE(lm.alquiler, ca.alquiler_actual) AS alquiler_liquidacion,\n        -- Si el porcentaje es null, forzamos un 0% para no romper la matemática\n        COALESCE(ca.porcentaje_honorarios, 0) AS porcentaje_honorarios_aplicado,\n        -- Cálculo sobre el alquiler de la liquidación: Alquiler - (Alquiler * (Honorarios / 100))\n        (COALESCE(lm.alquiler, ca.alquiler_actual) - ROUND(COALESCE(lm.alquiler, ca.alquiler_actual) * (COALESCE(ca.porcentaje_honorarios, 0) / 100.0), 2)) AS monto_neto,\n        (\n            SELECT STRING_AGG(dp.nombre, ' y ' ORDER BY dp.apellido, dp.nombre)\n            FROM propiedades_propietarios pp\n            JOIN datos_propietarios dp ON pp.id_propietario = dp.id_propietario\n            WHERE pp.id_propiedad = ca.id_propiedad\n        ) AS nombre_propietario\n    FROM liquidaciones_mensuales lm\n    JOIN contratos_de_alquileres ca ON lm.id_contrato = ca.id_contrato\n    WHERE lm.id_liquidacion = {{ $json.id_liquidacion }}\n)\nSELECT \n    id_liquidacion,\n    id_contrato,\n    alquiler_liquidacion AS alquiler_actual,\n    ROUND(porcentaje_honorarios_aplicado, 2) AS porcentaje_honorarios_aplicado,\n    ROUND(monto_neto, 2) AS monto_neto,\n    nombre_propietario\nFROM datos_pago;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -576,
        80
      ],
      "id": "81e31520-18d3-4d8a-b03f-b39a7202058a",
      "name": "Calcular Neto Propietario",
      "credentials": {
        "postgres": {
          "id": "REDACTED_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH nuevo_pago AS (\n    INSERT INTO pagos_propietarios (\n        id_liquidacion,\n        fecha_pago,\n        monto_neto,\n        id_estado_pago,\n        porcentaje_honorarios_aplicado,\n        created_at\n    ) VALUES (\n        {{ $('Calcular Neto Propietario').item.json.id_liquidacion }},\n        '{{ $('Edit Fields').item.json.fecha_pago }}'::DATE,\n        {{ $('Calcular Neto Propietario').item.json.monto_neto }},\n        2, \n        {{ $('Calcular Neto Propietario').item.json.porcentaje_honorarios_aplicado }},\n        NOW()\n    )\n    ON CONFLICT (id_liquidacion) DO NOTHING\n    RETURNING id_pago_propietario\n)\nSELECT * FROM nuevo_pago;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
