    {
      "parameters": {
        "jsCode": "const contrato = $('Loop Contratos').item.json;\nconst meses = Math.max(1, parseInt(contrato.frecuencia_de_actualizacion, 10) || 1);\nconst hoy = new Date();\nconst fechaDesde = new Date(hoy);\nfechaDesde.setMonth(fechaDesde.getMonth() - meses);\n\nconst formatoFecha = (fecha) => fecha.toISOString().split('T')[0];\n\nreturn {\n  desde: formatoFecha(fechaDesde),\n  hasta: formatoFecha(hoy)\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1552,
        864
      ],
      "id": "84b215c4-72b9-44f7-9019-50d01444b2b8",
      "name": "Calcular Fechas ICL"
    },
    {
      "parameters": {
        "jsCode": "const contrato = $('Loop Contratos').item.json;\nconst indice = contrato.indice_de_actualizacion;\nconst data = $input.item.json.data;\nconst meses = Math.max(1, parseInt(contrato.frecuencia_de_actualizacion, 10) || 1);\nconst idxAnterior = Math.min(meses, data.length - 1);\nconst indiceActual = Number(data[0][1]);\nconst indiceAnterior = Number(data[idxAnterior][1]);\nconst porcentajeIPC = ((indiceActual - indiceAnterior) / indiceAnterior) * 100;\nlet porcentaje = porcentajeIPC;\nif (indice === 'Casa Propia') {\n  // Usa IPC acumulado del período y aplica el 70% de Casa Propia\n  porcentaje = porcentajeIPC * 0.7;\n}\n\nconst [anio, mes, dia] = String(contrato.proxima_actualizacion).slice(0, 10).split('-').map(Number);\nconst proximaActual = new Date(Date.UTC(anio, (mes - 1) + meses, dia || 1));\nconst proximaActualizacion = proximaActual.toISOString().split('T')[0];\n\nreturn {\n  id_contrato: contrato.id_contrato,\n  alquiler_actual: Number(contrato.alquiler_actual),\n  inquilinos: contrato.inquilinos,\n  porcentaje: parseFloat(porcentaje.toFixed(2)),\n  alquiler_nuevo: parseFloat((Number(contrato.alquiler_actual) * (1 + porcentaje / 100)).toFixed(2)),\n  indice_de_actualizacion: indice,\n  proxima_actualizacion: proximaActualizacion,\n  moneda: contrato.moneda || 'ARS',\n  updated_at: new Date().toISOString()\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1104,
        416
      ],
      "id": "b4b92d03-56cc-4f04-88f1-46a26bd61dff",
      "name": "Code-Calcular porcentaje IPC"
    },
    {
      "parameters": {
        "jsCode": "const contrato = $('Loop Contratos').item.json;\nconst meses = Math.max(1, parseInt(contrato.frecuencia_de_actualizacion, 10) || 1);\nconst valores = [...($input.item.json.data || [])].sort((a, b) => String(a.fecha || '').localeCompare(String(b.fecha || '')));\nconst iclActual = Number(valores[valores.length - 1].valor);\nconst iclAnterior = Number(valores[0].valor);\nconst porcentaje = ((iclActual - iclAnterior) / iclAnterior) * 100;\n\nconst [anio, mes, dia] = String(contrato.proxima_actualizacion).slice(0, 10).split('-').map(Number);\nconst proximaActual = new Date(Date.UTC(anio, (mes - 1) + meses, dia || 1));\nconst proximaActualizacion = proximaActual.toISOString().split('T')[0];\n\nreturn {\n  id_contrato: contrato.id_contrato,\n  alquiler_actual: Number(contrato.alquiler_actual),\n  inquilinos: contrato.inquilinos,\n  porcentaje: parseFloat(porcentaje.toFixed(2)),\n  alquiler_nuevo: parseFloat((Number(contrato.alquiler_actual) * (1 + porcentaje / 100)).toFixed(2)),\n  indice_de_actualizacion: 'ICL',\n  proxima_actualizacion: proximaActualizacion,\n  moneda: contrato.moneda || 'ARS',\n  updated_at: new Date().toISOString()\n};"
      },
