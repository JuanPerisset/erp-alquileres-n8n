    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  c.id_contrato,\n  c.alquiler_actual,\n  c.frecuencia_de_actualizacion,\n  c.proxima_actualizacion,\n  c.indice_de_actualizacion,\n  COALESCE(c.moneda, 'ARS') AS moneda,\n  STRING_AGG(d.nombre || ' ' || d.apellido, ', ' ORDER BY d.apellido, d.nombre) AS inquilinos\nFROM contratos_de_alquileres c\nJOIN contratos_inquilinos ci ON c.id_contrato = ci.id_contrato\nJOIN datos_inquilinos d ON ci.id_inquilino = d.id_inquilino\nJOIN estados_contrato ec ON c.id_estado_contrato = ec.id_estado_contrato\nWHERE c.proxima_actualizacion <= CURRENT_DATE\nAND LOWER(ec.nombre) = 'activo'\nGROUP BY \n  c.id_contrato,\n  c.alquiler_actual,\n  c.frecuencia_de_actualizacion,\n  c.proxima_actualizacion,\n  c.indice_de_actualizacion,\n  c.moneda\nORDER BY c.id_contrato",
        "options": {}
